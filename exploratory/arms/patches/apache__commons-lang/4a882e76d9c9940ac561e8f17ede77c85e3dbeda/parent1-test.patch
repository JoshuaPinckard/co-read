+        }
+
+        // Calendar.
+        {
+            String value = DateFormatUtils.format(cal, DateFormatUtils.ISO_DATETIME_TIME_ZONE_FORMAT.getPattern(), TimeZone.getTimeZone("Europe/Paris"));
+            assertEquals("calendar", "2009-10-16T08:42:16+02:00", value);
+        }
