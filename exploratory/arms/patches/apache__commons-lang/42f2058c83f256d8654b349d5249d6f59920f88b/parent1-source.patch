-            return u.toBytes(s);
-        }
-
-        @Override
-        public long toBits(final long size) {
-            return size;
-        }
-
-        @Override
-        public long toBytes(final long size) {
-            return size / K1;
-        }
-
-        @Override
-        public long toGigabytes(final long size) {
