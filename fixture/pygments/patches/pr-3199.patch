new file mode 100644
index 0000000000000000000000000000000000000000..dc423b46e717ea493a6e013049a1e67b9b6d9e21
--- /dev/null
+++ b/tests/examplefiles/go/3199.go
@@ -0,0 +1,16 @@
+package main
+
+func main() {
+	var (
+		float float32
+		_ = float64(float)
+		_ map[string]any
+		_ chan int
+		_ = [...]int{0o755, 0O_644, 0777}
+		x = 0b1100 ^ 0B1001 | 0b00_10
+		_ = 1_000_000
+		_ = 0x_fefe_1a3d
+		_ = !(x > 0 && x < 8)
+	)
+	x ^= 0b_0101
+}
