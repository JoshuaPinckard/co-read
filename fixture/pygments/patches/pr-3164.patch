+
+---tokens---
+'function'    Keyword
+' '           Text.Whitespace
+'['           Punctuation
+'o1, ...\n    o2' Text
+']'           Punctuation
+' '           Text.Whitespace
+'='           Punctuation
+' '           Text.Whitespace
+'my_fun'      Name.Function
+'('           Punctuation
+'a1, '        Text
+'...\n'       Comment
+
