+@pytest.mark.parametrize('environment', [
+    'math', 'displaymath', 'equation', 'equation*', 'align', 'align*',
+])
+def test_tex_math_environments(environment):
+    tokens = list(TexLexer().get_tokens(
+        rf'\begin{{{environment}}}x+1\end{{{environment}}}'
